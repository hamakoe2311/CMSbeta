<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>LifeOS Pro - 統合管理</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root { --bg: #121212; --card: #1e1e1e; --primary: #00e676; --sub: #03a9f4; --warn: #ff5252; --text: #fff; --gray: #888; --nav-bg: #1a1a1a; }
        body { background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 0; padding: 0; padding-bottom: 70px; }
        
        /* 共通UI */
        .card { background: var(--card); padding: 15px; margin: 10px; border-radius: 12px; border: 1px solid #333; }
        h1, h2 { font-size: 1.1rem; border-left: 4px solid var(--primary); padding-left: 10px; margin: 10px 0; }
        h2.memo-header { border-left-color: var(--sub); }
        
        input, select, textarea, button { 
            width: 100%; padding: 12px; margin: 5px 0; border-radius: 8px; border: 1px solid #444; 
            background: #2c2c2c; color: #fff; font-size: 16px; box-sizing: border-box; outline: none;
        }
        input:focus, textarea:focus, select:focus { border-color: var(--primary); }
        textarea { resize: vertical; min-height: 80px; }
        
        button { background: var(--primary); color: #000; font-weight: bold; border: none; cursor: pointer; transition: 0.2s; }
        button:active { opacity: 0.7; }
        .btn-add { background: var(--sub); color: #fff; }
        .btn-del { background: var(--warn); color: #fff; padding: 8px; font-size: 14px; flex-shrink: 0; }
        .btn-outline { background: transparent; border: 1px solid var(--primary); color: var(--primary); }
        
        .flex { display: flex; gap: 8px; align-items: center; }
        .badge { padding: 4px 8px; border-radius: 12px; font-size: 0.75rem; background: #444; color: #fff; white-space: nowrap; }
        
        /* タブナビゲーション */
        .bottom-nav { position: fixed; bottom: 0; left: 0; width: 100%; background: var(--nav-bg); display: flex; border-top: 1px solid #333; z-index: 100; padding-bottom: env(safe-area-inset-bottom); }
        .nav-item { flex: 1; text-align: center; padding: 15px 0; color: var(--gray); font-size: 0.85rem; cursor: pointer; }
        .nav-item.active { color: var(--primary); font-weight: bold; border-top: 2px solid var(--primary); }
        
        /* ビュー管理 */
        .view { display: none; animation: fadeIn 0.3s ease; }
        .view.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        /* タスク用 */
        .task-item { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid #333; }
        .task-item.done span.text { text-decoration: line-through; color: var(--gray); }
        .task-checkbox { width: 24px; height: 24px; accent-color: var(--primary); flex-shrink: 0; }
        
        /* メモ・家計リスト用 */
        .list-item { background: #252525; padding: 10px; margin-bottom: 10px; border-radius: 8px; border-left: 3px solid var(--sub); }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        
        /* 家計用 */
        canvas { background: #fff; border-radius: 12px; margin: 10px; max-height: 250px; width: calc(100% - 20px) !important; box-sizing: border-box; }
        .summary-val { font-size: 1.4rem; font-weight: bold; }
        .gb-badge { background: var(--sub); color: #fff; padding: 4px 10px; border-radius: 12px; font-size: 0.9rem; }
    </style>
</head>
<body>

<!-- 今日タブ (ToDo & KPT) -->
<div id="view-today" class="view active">
    <div class="card flex" style="justify-content: center;">
        <button id="btn-prev-day" style="width:auto; padding:8px;">◀</button>
        <input type="date" id="input-date" style="width:auto; font-size:1.1rem; font-weight:bold; background:transparent; border:none; color:var(--primary); text-align:center;">
        <button id="btn-next-day" style="width:auto; padding:8px;">▶</button>
    </div>

    <div class="card">
        <h2>今日のタスク</h2>
        <div class="flex">
            <select id="task-cat" style="width: 35%;">
                <option value="業務">業務</option><option value="勉強">勉強</option><option value="手続き">手続き</option><option value="私用">私用</option>
            </select>
            <input type="text" id="task-text" placeholder="タスク入力" style="width: 65%;">
        </div>
        <button id="btn-add-task">追加</button>
        <div id="task-list"></div>
    </div>

    <div class="card">
        <h2>今日の振り返り</h2>
        <label style="font-size:0.8rem; color:var(--primary);">【Keep】学んだこと・できたこと</label>
        <textarea id="ref-keep"></textarea>
        <label style="font-size:0.8rem; color:var(--warn);">【Problem】課題・失敗</label>
        <textarea id="ref-problem"></textarea>
        <label style="font-size:0.8rem; color:var(--sub);">【Try】明日の対策</label>
        <textarea id="ref-try"></textarea>
    </div>
</div>

<!-- メモタブ -->
<div id="view-memo" class="view">
    <div class="card">
        <h2 class="memo-header">メモ追加・編集</h2>
        <input type="hidden" id="memo-id">
        <input type="text" id="memo-title" placeholder="タイトル">
        <input type="text" id="memo-tags" placeholder="タグ (カンマ区切り)">
        <textarea id="memo-content" placeholder="内容..."></textarea>
        <div class="flex">
            <button id="btn-save-memo" class="btn-add">保存</button>
            <button id="btn-clear-memo" class="btn-outline">クリア</button>
        </div>
    </div>
    <div class="card">
        <input type="text" id="memo-search" placeholder="🔍 メモを検索...">
        <div id="memo-list"></div>
    </div>
</div>

<!-- 家計タブ -->
<div id="view-finance" class="view">
    <div class="card">
        <h2>全体集計</h2>
        <div class="flex" style="justify-content: space-between;">
            <div>残金: <span id="total-balance" class="summary-val">0</span>円</div>
            <div id="total-gb" class="gb-badge">0 GB</div>
        </div>
    </div>
    
    <div class="card">
        <button id="btn-add-month" class="btn-outline">＋ 新しい月を追加</button>
    </div>

    <canvas id="chart-pie"></canvas>
    <canvas id="chart-line"></canvas>

    <div id="finance-list"></div>
</div>

<!-- 設定・バックアップタブ -->
<div id="view-backup" class="view">
    <div class="card">
        <h2>データ管理 (JSON)</h2>
        <p style="font-size:0.9rem; color:var(--gray);">すべてのデータ（タスク、メモ、家計）を1つのファイルで保存・復元します。複数ファイルを選択すると結合されます。</p>
        <button id="btn-export" style="margin-bottom: 20px;">📥 全データをバックアップ保存</button>
        
        <label style="display:block; margin-bottom:5px;">📤 データを復元・結合</label>
        <input type="file" id="file-import" multiple accept=".json" style="background:#111;">
    </div>
    <div class="card">
        <button id="btn-danger-reset" style="background:transparent; color:var(--warn); border:1px solid var(--warn);">⚠️ 全データ初期化</button>
    </div>
</div>

<!-- 下部ナビゲーション -->
<div class="bottom-nav">
    <div class="nav-item active" data-target="view-today">今日</div>
    <div class="nav-item" data-target="view-memo">メモ</div>
    <div class="nav-item" data-target="view-finance">家計・GB</div>
    <div class="nav-item" data-target="view-backup">設定</div>
</div>

<script>
/* =========================================
   1. 状態管理 (State Management)
========================================= */
const DEFAULT_STATE = { dates: {}, memos: [], finance: [] };
let appState = JSON.parse(localStorage.getItem('lifeos_data')) || DEFAULT_STATE;
let currentDate = new Date().toISOString().split('T')[0];
let activeTab = 'view-today';
let charts = {};

// 状態を更新して保存・再描画する関数
function setState(updater, reRender = true) {
    updater(appState);
    localStorage.setItem('lifeos_data', JSON.stringify(appState));
    if (reRender) renderActiveTab();
}

// 今日のデータ初期化ヘルパー
function ensureDateState(dateStr) {
    if (!appState.dates[dateStr]) {
        setState(state => {
            state.dates[dateStr] = { tasks: [], reflection: { keep: "", problem: "", try: "" } };
        }, false);
    }
}

/* =========================================
   2. DOM生成ヘルパー (innerHTML排除)
========================================= */
function el(tag, attributes = {}, ...children) {
    const element = document.createElement(tag);
    for (const key in attributes) {
        if (key.startsWith('on') && typeof attributes[key] === 'function') {
            element.addEventListener(key.substring(2).toLowerCase(), attributes[key]);
        } else if (key === 'className') {
            element.className = attributes[key];
        } else {
            element[key] = attributes[key];
        }
    }
    children.forEach(child => {
        if (typeof child === 'string' || typeof child === 'number') {
            element.appendChild(document.createTextNode(child));
        } else if (child instanceof Node) {
            element.appendChild(child);
        }
    });
    return element;
}

/* =========================================
   3. 初期化とイベントリスナー登録 (onclick排除)
========================================= */
function init() {
    ensureDateState(currentDate);
    document.getElementById('input-date').value = currentDate;

    // タブ切り替え
    document.querySelectorAll('.nav-item').forEach(item => {
        item.addEventListener('click', (e) => {
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
            e.target.classList.add('active');
            activeTab = e.target.dataset.target;
            document.getElementById(activeTab).classList.add('active');
            renderActiveTab();
        });
    });

    // 今日タブイベント
    document.getElementById('input-date').addEventListener('change', e => changeDate(e.target.value));
    document.getElementById('btn-prev-day').addEventListener('click', () => stepDate(-1));
    document.getElementById('btn-next-day').addEventListener('click', () => stepDate(1));
    document.getElementById('btn-add-task').addEventListener('click', addTask);
    document.getElementById('task-text').addEventListener('keypress', e => { if(e.key==='Enter') addTask(); });

    ['keep', 'problem', 'try'].forEach(key => {
        document.getElementById(`ref-${key}`).addEventListener('input', e => {
            setState(state => state.dates[currentDate].reflection[key] = e.target.value, false); // 入力中は再描画しない
        });
    });

    // メモタブイベント
    document.getElementById('btn-save-memo').addEventListener('click', saveMemo);
    document.getElementById('btn-clear-memo').addEventListener('click', clearMemoInput);
    document.getElementById('memo-search').addEventListener('input', renderMemos);

    // 家計タブイベント
    document.getElementById('btn-add-month').addEventListener('click', addFinanceMonth);

    // バックアップタブイベント
    document.getElementById('btn-export').addEventListener('click', exportData);
    document.getElementById('file-import').addEventListener('change', importData);
    document.getElementById('btn-danger-reset').addEventListener('click', resetData);

    renderActiveTab();
}

/* =========================================
   4. レンダリングロジック
========================================= */
function renderActiveTab() {
    if (activeTab === 'view-today') renderToday();
    else if (activeTab === 'view-memo') renderMemos();
    else if (activeTab === 'view-finance') renderFinance();
}

// --- 今日タブ ---
function stepDate(days) {
    let d = new Date(currentDate);
    d.setDate(d.getDate() + days);
    changeDate(d.toISOString().split('T')[0]);
}

function changeDate(dateStr) {
    currentDate = dateStr;
    document.getElementById('input-date').value = currentDate;
    ensureDateState(currentDate);
    renderToday();
}

function renderToday() {
    const data = appState.dates[currentDate];
    
    // 振り返りテキストエリア（上書き）
    document.getElementById('ref-keep').value = data.reflection.keep || "";
    document.getElementById('ref-problem').value = data.reflection.problem || "";
    document.getElementById('ref-try').value = data.reflection.try || "";

    // タスクリストDOM再構築
    const list = document.getElementById('task-list');
    list.innerHTML = "";
    
    const sortedTasks = [...data.tasks].sort((a, b) => a.done - b.done);
    sortedTasks.forEach(t => {
        const checkbox = el('input', { type: 'checkbox', className: 'task-checkbox', checked: t.done, onChange: () => toggleTask(t.id) });
        const badge = el('span', { className: 'badge' }, t.category);
        const text = el('span', { className: 'text', style: 'flex-grow:1' }, t.text);
        const delBtn = el('button', { className: 'btn-del', onClick: () => delTask(t.id) }, "✕");
        
        const item = el('div', { className: `task-item ${t.done ? 'done' : ''}` }, checkbox, badge, text, delBtn);
        list.appendChild(item);
    });
}

function addTask() {
    const textEl = document.getElementById('task-text');
    const text = textEl.value.trim();
    if (!text) return;
    setState(state => {
        state.dates[currentDate].tasks.push({
            id: Date.now(), text, category: document.getElementById('task-cat').value, done: false
        });
    });
    textEl.value = "";
}

function toggleTask(id) {
    setState(state => {
        const t = state.dates[currentDate].tasks.find(x => x.id === id);
        if(t) t.done = !t.done;
    });
}
function delTask(id) { setState(state => state.dates[currentDate].tasks = state.dates[currentDate].tasks.filter(x => x.id !== id)); }

// --- メモタブ ---
function saveMemo() {
    const id = document.getElementById('memo-id').value;
    const title = document.getElementById('memo-title').value.trim() || "無題";
    const tags = document.getElementById('memo-tags').value.split(',').map(t=>t.trim()).filter(t=>t);
    const content = document.getElementById('memo-content').value.trim();
    if (!content) return alert("内容を入力してください");

    setState(state => {
        if (id) {
            const m = state.memos.find(x => x.id == id);
            if(m) { m.title = title; m.tags = tags; m.content = content; m.date = currentDate; }
        } else {
            state.memos.push({ id: Date.now(), title, tags, content, date: currentDate });
        }
    });
    clearMemoInput();
}

function clearMemoInput() {
    ['memo-id', 'memo-title', 'memo-tags', 'memo-content'].forEach(id => document.getElementById(id).value = "");
}

function editMemo(id) {
    const m = appState.memos.find(x => x.id === id);
    if(!m) return;
    document.getElementById('memo-id').value = m.id;
    document.getElementById('memo-title').value = m.title;
    document.getElementById('memo-tags').value = m.tags.join(', ');
    document.getElementById('memo-content').value = m.content;
    window.scrollTo(0,0);
}

function delMemo(id) { if(confirm("削除しますか？")) setState(state => state.memos = state.memos.filter(x => x.id !== id)); }

function renderMemos() {
    const list = document.getElementById('memo-list');
    list.innerHTML = "";
    const query = document.getElementById('memo-search').value.toLowerCase();
    
    const filtered = [...appState.memos].reverse().filter(m => 
        (m.title + m.content + m.tags.join(" ")).toLowerCase().includes(query)
    );

    filtered.forEach(m => {
        const header = el('div', { className: 'flex', style: 'justify-content:space-between; margin-bottom:5px;' },
            el('strong', { style: 'color:var(--sub)' }, m.title),
            el('div', { className: 'flex' },
                el('button', { className: 'btn-outline', style: 'padding:4px 8px; font-size:12px;', onClick: () => editMemo(m.id) }, "編集"),
                el('button', { className: 'btn-del', onClick: () => delMemo(m.id) }, "✕")
            )
        );
        const tags = el('div', { style: 'margin-bottom:8px; display:flex; gap:5px; flex-wrap:wrap;' }, 
            ...m.tags.map(t => el('span', { className: 'badge' }, `#${t}`))
        );
        const content = el('div', { style: 'white-space:pre-wrap; font-size:0.9rem; color:#ddd;' }, m.content);
        
        list.appendChild(el('div', { className: 'list-item' }, header, tags, content));
    });
}

// --- 家計・GBタブ ---
const expCats = ["食費", "通信費", "住宅費", "交通費", "娯楽", "その他"];

function addFinanceMonth() {
    const m = prompt("月を入力 (例: 2024-04)", currentDate.slice(0,7));
    if (!m) return;
    setState(state => {
        if(!state.finance.find(x=>x.month===m)) {
            state.finance.push({ month: m, income: [{name:"給料", amount:0}], expenses: [] });
        }
    });
}

function renderFinance() {
    const list = document.getElementById('finance-list');
    list.innerHTML = "";
    let gInc = 0, gExp = 0, gGB = 0, catMap = {}, dayMap = {};

    [...appState.finance].sort((a,b) => a.month > b.month ? -1 : 1).forEach((m, mIdx) => {
        let mInc = Number(m.income[0]?.amount || 0); gInc += mInc;
        
        const card = el('div', { className: 'card' });
        const header = el('div', { className: 'flex', style: 'justify-content:space-between; margin-bottom:10px;' },
            el('h2', { style: 'margin:0;' }, m.month),
            el('button', { className: 'btn-del', onClick: () => { if(confirm("月ごと削除しますか？")) setState(s=>s.finance.splice(mIdx,1)); } }, "月削除")
        );
        
        const incInput = el('input', { type: 'number', value: mInc, placeholder: '月収', 
            onChange: (e) => setState(s => s.finance[mIdx].income[0].amount = Number(e.target.value)) 
        });

        const expContainer = el('div', { style: 'margin-top:10px;' });
        
        m.expenses.forEach((e, eIdx) => {
            const amt = Number(e.amount||0), gb = Number(e.gb||0);
            gExp += amt; gGB += gb;
            catMap[e.category] = (catMap[e.category]||0) + amt;
            dayMap[`${m.month}-${e.date}`] = (dayMap[`${m.month}-${e.date}`]||0) + amt;

            const row1 = el('div', { className: 'grid-2' },
                el('input', { type: 'text', value: e.name, placeholder: '品名', onChange: ev => setState(s => s.finance[mIdx].expenses[eIdx].name = ev.target.value) }),
                el('input', { type: 'number', value: e.amount, placeholder: '金額', onChange: ev => setState(s => s.finance[mIdx].expenses[eIdx].amount = Number(ev.target.value)) })
            );

            const catSelect = el('select', { onChange: ev => setState(s => s.finance[mIdx].expenses[eIdx].category = ev.target.value) },
                ...expCats.map(c => {
                    const opt = el('option', { value: c }, c);
                    if(e.category === c) opt.selected = true;
                    return opt;
                })
            );

            const row2Items = [catSelect];
            if(e.category === '通信費') {
                row2Items.push(el('input', { type: 'number', value: e.gb, placeholder: 'GB', style:'border-color:var(--sub)', onChange: ev => setState(s => s.finance[mIdx].expenses[eIdx].gb = Number(ev.target.value)) }));
            }
            row2Items.push(el('button', { className: 'btn-del', style:'width:auto', onClick: () => setState(s => s.finance[mIdx].expenses.splice(eIdx,1)) }, "✕"));
            
            const row2 = el('div', { className: 'flex', style:'margin-top:5px;' }, ...row2Items);
            expContainer.appendChild(el('div', { style: 'border-top:1px solid #333; padding-top:10px; margin-top:10px;' }, row1, row2));
        });

        const addBtn = el('button', { className: 'btn-add', style: 'margin-top:10px;', onClick: () => setState(s => s.finance[mIdx].expenses.push({ date: currentDate.slice(8,10), name: "", amount: 0, category: "食費", gb: 0 })) }, "＋ 支出追加");

        card.append(header, el('label',{style:'font-size:0.8rem;color:var(--gray)'},"収入"), incInput, expContainer, addBtn);
        list.appendChild(card);
    });

    document.getElementById('total-balance').innerText = (gInc - gExp).toLocaleString();
    document.getElementById('total-gb').innerText = gGB.toFixed(1) + " GB";
    
    updateCharts(catMap, dayMap);
}

function updateCharts(catData, dayData) {
    const opt = { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#fff' } } } };
    
    if(charts.pie) charts.pie.destroy();
    charts.pie = new Chart(document.getElementById("chart-pie"), {
        type: 'doughnut',
        data: { labels: Object.keys(catData), datasets: [{ data: Object.values(catData), backgroundColor: ['#ff6384','#36a2eb','#ffce56','#4bc0c0','#9966ff','#ff9f40'] }] },
        options: opt
    });

    if(charts.line) charts.line.destroy();
    const dates = Object.keys(dayData).sort();
    charts.line = new Chart(document.getElementById("chart-line"), {
        type: 'line',
        data: { labels: dates.map(d=>d.slice(5)), datasets: [{ label: '支出推移', data: dates.map(d=>dayData[d]), borderColor: '#00e676', tension: 0.2 }] },
        options: { ...opt, scales: { x: { ticks: { color: '#fff' } }, y: { ticks: { color: '#fff' } } } }
    });
}

/* =========================================
   5. データ管理 (バックアップ・復元)
========================================= */
function exportData() {
    const blob = new Blob([JSON.stringify(appState, null, 2)], {type: "application/json"});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = `lifeos_backup_${currentDate}.json`;
    a.click();
}

async function importData(e) {
    const files = Array.from(e.target.files);
    if(files.length === 0) return;

    let mergedState = JSON.parse(JSON.stringify(appState)); // ディープコピー

    for (const file of files) {
        try {
            const text = await file.text();
            const json = JSON.parse(text);

            // LifeOS形式の統合JSONの場合のマージ処理
            if(json.dates || json.memos || json.finance) {
                if(json.dates) Object.assign(mergedState.dates, json.dates); // 日付上書き
                if(json.memos) {
                    json.memos.forEach(im => {
                        const idx = mergedState.memos.findIndex(m => m.id === im.id);
                        if(idx >= 0) mergedState.memos[idx] = im; else mergedState.memos.push(im);
                    });
                }
                if(json.finance) {
                    json.finance.forEach(ifn => {
                        const idx = mergedState.finance.findIndex(f => f.month === ifn.month);
                        if(idx >= 0) mergedState.finance[idx] = ifn; else mergedState.finance.push(ifn);
                    });
                }
            } 
            // 古い家計簿アプリ(Pro Max)単体のJSON（配列形式）の互換性対応
            else if (Array.isArray(json)) {
                json.forEach(ifn => {
                    if(ifn.month) {
                        const idx = mergedState.finance.findIndex(f => f.month === ifn.month);
                        if(idx >= 0) mergedState.finance[idx] = ifn; else mergedState.finance.push(ifn);
                    }
                });
            }
        } catch (err) { alert("読み込みエラー: " + file.name); }
    }

    setState(() => Object.assign(appState, mergedState));
    alert("データの結合・復元が完了しました！");
    e.target.value = ""; // リセット
}

function resetData() {
    if(prompt("本当に初期化しますか？「削除」と入力してください。") === "削除") {
        localStorage.removeItem('lifeos_data');
        location.reload();
    }
}

// 起動
init();
</script>
</body>
</html>
